{
  "name": "agropec",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:backend": "bun run --cwd backend dev",
    "dev:frontend": "bun run --cwd frontend dev",
    "migrate": "bun run --cwd backend migrate",
    "seed": "bun run --cwd backend seed"
  }
}
