{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "src/*": ["src/*"]
    },
    "types": ["quasar", "@quasar/app-vite", "node"],
    "lib": ["esnext", "dom", "dom.iterable"]
  },
  "exclude": ["./dist", "./.quasar", "./node_modules", "./.eslintrc.cjs"]
}
