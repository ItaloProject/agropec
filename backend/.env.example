# Banco de dados Turso (SQLite serverless) — crie em turso.tech
TURSO_URL=libsql://seu-banco.turso.io
TURSO_TOKEN=seu-token-aqui

# Chave secreta do JWT — gere uma string aleatória longa
JWT_SECRET=troque-por-uma-chave-secreta-aleatoria

# URL do frontend (para CORS em dev local)
FRONTEND_URL=http://localhost:9000

# Porta — apenas para dev local
PORT=3001
