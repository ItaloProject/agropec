# Caminho do banco SQLite — no Railway, use o Volume montado em /data
DATABASE_URL=/data/agropec.db

# Chave secreta do JWT — gere uma string aleatória longa em produção
JWT_SECRET=troque-por-uma-chave-secreta-aleatoria

# URL do frontend no Vercel (para CORS)
FRONTEND_URL=https://seu-frontend.vercel.app

# Porta — o Railway define automaticamente via variável PORT
PORT=3001
